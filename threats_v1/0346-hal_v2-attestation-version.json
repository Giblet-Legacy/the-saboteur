{
  "name": "Change the attestation's version (hal_v2)",
  "target_file": "seals/seal-approve.json",
  "mutation": "json_set:lambda_attestation.version=\"9.9.9\"",
  "tool": "python legacy_check_v1.py --layer hal_v2",
  "expect_exit": "non-zero",
  "expect_error_contains": [
    "failed seals/seal-approve.json: hal_v2.verify_seal"
  ],
  "notes": "version is attested."
}
