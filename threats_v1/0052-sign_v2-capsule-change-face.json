{
  "name": "Change a claim's face to OPINION (sign_v2)",
  "target_file": "capsules/claim-forge.sc.json",
  "mutation": "json_set:face=\"OPINION\"",
  "tool": "python legacy_check_v1.py --layer sign_v2",
  "expect_exit": "non-zero",
  "expect_error_contains": [
    "failed capsules/claim-forge.sc.json: sign_v2.verify_capsule said no"
  ],
  "notes": "The polarity of a claim is signed."
}
